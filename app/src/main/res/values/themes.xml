=== ABOUT: Fixed the missing window theme so the app starts on a near-black background without an action bar ===
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GhostBank" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF050607</item>
        <item name="android:statusBarColor">#FF050607</item>
        <item name="android:navigationBarColor">#FF050607</item>
    </style>
</resources>
